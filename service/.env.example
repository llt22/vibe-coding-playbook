# 初筛用的模型：任意 OpenAI 兼容接口（需支持 response_format: json_object）
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=

# 本机直连 github.com 不稳定，走本机代理；模型接口若在国内可加进 NO_PROXY
HTTPS_PROXY=http://127.0.0.1:7897
NO_PROXY=localhost,127.0.0.1

# 可选：推送接口 token（自己生成的随机串），以后 Ego 推送 X 内容时用
INGEST_TOKEN=
# 可选：提高 GitHub 搜索限额
GITHUB_TOKEN=
